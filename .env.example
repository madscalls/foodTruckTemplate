# Copy to .env.local and fill in to go live. Leave blank to use the sample data.

# Google Calendar: the truck's schedule. Make the calendar public, then create an
# API key (Google Cloud console > APIs & Services > Credentials) restricted to the
# Calendar API and to the site's domain.
VITE_GCAL_ID=
VITE_GCAL_KEY=

# Catering form: a form endpoint (e.g. Formspree, Basin) that emails the request.
VITE_FORM_ENDPOINT=
